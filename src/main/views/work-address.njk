{% extends "template.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}

{% block beforeContent %}
  {{ super() }}
  {% include "back-link.njk"%}
{% endblock %}

{% block content %}
  {% block errorSummary %}
   {% include "error-summary.njk" %}
  {% endblock %}

  {% set field = form.fields.claimantWorkAddressQuestion %}
  {% set legendHtml %}
    <h1 class="govuk-fieldset__heading">{{ legend }}</h1>
    <span class="govuk-body govuk-!-display-block govuk-!-margin-top-4 govuk-!-margin-bottom-0">
      {{ addressLine1 }}<br>
      {% if addressLine2 %}{{ addressLine2 }}<br>{% endif %}
      {{ addressTown }}<br>
      {{ addressCountry }}<br>
      {{ addressPostcode }}
    </span>
  {% endset %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <form class="form" id="main-form" method="post" action="" novalidate="true">
        <input type="hidden" name="_csrf" value={{ csrfToken }}>
        {{ govukRadios({
          classes: field.classes,
          idPrefix: field.id,
          name: "claimantWorkAddressQuestion",
          fieldset: {
            legend: {
              html: legendHtml,
              classes: "govuk-fieldset__legend--xl"
            }
          },
          hint: {
            text: hintText
          },
          items: formItems(field.values, userCase.claimantWorkAddressQuestion) | radioPositions,
          errorMessage: getError("claimantWorkAddressQuestion"),
          formGroup: {
            classes: field.id
          }
        }) }}
        {% include "form/saveButtons.njk" %}
      </form>
    </div>
  </div>
{% endblock %}
